PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nourish?retryWrites=true&w=majority
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
RESEND_API_KEY=re_xxxxxxxxx
# Where new booking alerts are sent (must be your Resend account email until you verify a domain)
NOTIFY_EMAIL=hannah@example.com
MAIL_FROM=Nourish by Hannah <onboarding@resend.dev>
# Set to true only after verifying your own domain in Resend
SEND_CLIENT_CONFIRMATION=false
